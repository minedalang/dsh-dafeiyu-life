{
  "name": "dsh-dafeiyu-life",
  "version": "2.7.1-dev.44",
  "description": "大肥鱼 · DSH 生活系统：主 Session 可回忆人生记忆与真实经历、管理自主待办，并按权限使用 B站读取与互动；支持可遗忘人生记忆、情绪与兴趣成长、三级社交和有边界的自主意愿。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dafeiyu",
    "bilibili",
    "memory",
    "agent-companion",
    "persistent-agent",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minedalang/dsh-dafeiyu-life.git"
  },
  "homepage": "https://github.com/minedalang/dsh-dafeiyu-life#readme",
  "bugs": {
    "url": "https://github.com/minedalang/dsh-dafeiyu-life/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare:embedding-runtime": "node scripts/prepare-embedding-runtime.mjs",
    "check:life-architecture": "node scripts/check-life-architecture.mjs",
    "write:life-architecture-view": "node scripts/check-life-architecture.mjs --write-preview"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "scripts/prepare-embedding-runtime.mjs",
    "scripts/check-life-architecture.mjs",
    "tools/dev4-cold-state-backup.mjs",
    "tools/dev4-life-planner-offline-recovery.mjs",
    "tools/dev4-life-events-offline-review.mjs",
    "prompts",
    "vendor",
    "README.md",
    "docs/LIFE_MEMORY_2_TECHNICAL.md",
    "docs/architecture",
    "docs/archive/README.md",
    "AGENTS.md",
    "selfcheck.mjs",
    "LICENSE",
    "NOTICE.md",
    "THIRD_PARTY_NOTICES.md",
    "CONTRIBUTORS.md",
    "CHANGELOG.md",
    "RELEASE_NOTES_v2.6.2.md",
    "RELEASE_NOTES_v2.7.0.md",
    "RELEASE_NOTES_v2.7.1.md"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "yaml": "^2.8.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
