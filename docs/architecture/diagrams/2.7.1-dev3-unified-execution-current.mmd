flowchart TB
    A["行动入口：主人请求 / 自主规划 / 社交互动"] --> B["鱼鱼意愿 + 自主待办：做、不做、延期"]
    B --> C["现有授权、安全审核、额度、冷却、隐私"]

    subgraph R["① 共享只读动作（Node + Python）"]
      R1["动作身份：账号 + public/account + 工具 + 目标参数"] --> R2["跨进程只读预约"]
      R2 --> R3["已接入的 20 类 B站读取身份"]
      R3 --> R4["资料返回 / 只读回执"]
    end
    subgraph V["② 视觉特殊路径"]
      V1["只对低清预览帧抓取预约"] --> V2["独立 DSH 视觉模型：原权限与额度"]
      V2 --> V3["视觉证据分级：图片/描述不等于完整观看"]
    end
    subgraph W["③ 已接线的社交写入"]
      W1["已核验账号 + 类别 + 目标 + 内容摘要"] --> W2["持久写入预约：同日防重"]
