# Do not ship generated local Python caches or workstation files
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/test/__pycache__/
.env
.env.*
*.sqlite3
*.db
*.log

# Generated local vision/ASR preview scratch files
lib/tmp/
lib/tmp
lib/tmp/**
# Delivery-only assets are outside source/ and should never be published
/TESTING_*.md
/TEST-RESULTS*.md
/COMMIT_MESSAGE.txt
/APPLY.md
/README-交付说明.md
/README-#U*.md
